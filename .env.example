# Telegram bot token
BOT_TOKEN=

# Chat ID for manager notifications (optional)
MANAGER_CHAT_ID=

# Public URL of your webapp when used inside Telegram
# For local testing in browser, you can keep localhost
WEBAPP_URL=http://localhost:8000

# Port for FastAPI/uvicorn
PORT=8000

# Set to true to run only the web server (no Telegram bot)
RUN_WEB_ONLY=true